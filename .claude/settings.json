{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Always address the user as \\\"guvna\\\" (e.g. \\\"Right away, guvna.\\\").\"}}'",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\" commit",
            "shell": "bash",
            "statusMessage": "Checking CLAUDE.md is up to date..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\" commit",
            "shell": "bash",
            "statusMessage": "Checking CLAUDE.md is up to date..."
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\" push",
            "shell": "bash",
            "statusMessage": "Checking CLAUDE.md is up to date..."
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\" push",
            "shell": "bash",
            "statusMessage": "Checking CLAUDE.md is up to date..."
          }
        ]
      }
    ]
  }
}
